# Populate and save — the backend reads this on startup (run from backend/).
# Every value is optional; anything left empty falls back per the resilience table.

# OpenAI — GPT-4o document classification/extraction + embeddings for Qdrant
OPENAI_API_KEY=

# Neon Postgres — console.neon.tech -> project -> "Connection string"
# e.g. postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Neo4j AuraDB Free — console.neo4j.io -> instance URI + generated password
# e.g. neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Qdrant — leave BOTH empty to use the embedded local index (no account).
# Only set these if you created a Qdrant Cloud cluster (cloud.qdrant.io).
QDRANT_URL=
QDRANT_API_KEY=
